# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Streaming Availability API key (RapidAPI)
STREAMING_AVAILABILITY_API_KEY=
# SQLAlchemy database URL (default: sqlite:///data/whattowatch.db)
DATABASE_URL=
# LM Studio OpenAI-compatible base URL (default: http://localhost:1234/v1)
LM_STUDIO_BASE_URL=
# Netflix profile name used when filtering the viewing activity export
NETFLIX_PROFILE_NAME=
