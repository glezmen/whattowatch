# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# TMDB account session id: written by the app when you link your TMDB account (secret)
TMDB_SESSION_ID=
# Streaming Availability API key (RapidAPI)
STREAMING_AVAILABILITY_API_KEY=
# Days before a known leaving date when a notification is created (default: 14,7,3)
LEAVING_NOTICE_DAYS=
# SQLAlchemy database URL (default: sqlite:///data/whattowatch.db)
DATABASE_URL=
# LM Studio OpenAI-compatible base URL (default: http://localhost:1234/v1)
LM_STUDIO_BASE_URL=
# Netflix profile name used when filtering the viewing activity export (fallback only:
# the profile chosen in the web UI / `wtw settings` is stored in the database and wins)
NETFLIX_PROFILE_NAME=
# Directory for export files uploaded in the web UI (default: data/imports; keep it out of git)
IMPORTS_DIR=
# Directory for database backups and pre-restore safety snapshots (default: data/backups)
BACKUPS_DIR=
# Optional YAML file overriding recommender weights (see docs/recommender.md)
RECOMMENDER_CONFIG_PATH=
# Built frontend served at / when it exists (default: frontend/dist, relative to the working dir)
FRONTEND_DIST=
# LLM provider: lmstudio (local, default) | anthropic | openai | claude_code (local `claude` CLI login)
LLM_PROVIDER=
# Model name; empty -> lmstudio: first loaded model, anthropic: claude-opus-5-5, openai: gpt-4o-mini
LLM_MODEL=
# Embedding model for the OpenAI-compatible /embeddings endpoint (empty -> embeddings disabled)
LLM_EMBEDDING_MODEL=
# Cloud API keys (separately billed; a ChatGPT/Claude subscription is not API access)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Allow the caller to switch to another provider when the chosen one is unavailable (default false)
LLM_FALLBACK_ALLOWED=
# Allow sending raw "liked/disliked" feedback text to a cloud provider (default false)
LLM_CLOUD_SEND_FEEDBACK_TEXT=
# Anthropic server-side model fallback on policy declines (default true)
ANTHROPIC_SERVER_FALLBACK=
# Claude Code CLI model (sonnet | opus | haiku) used when LLM_MODEL is empty (empty -> CLI default)
CLAUDE_CODE_MODEL=
# Location of this file itself is set by the WTW_ENV_FILE process environment variable
# (default: ./.env; Docker: /app/data/.env). Setting it here has no effect.
